PORT=3015
IMAGES_DIR=images

# Cloudinary (required for image hosting)
# Get credentials from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: folder prefix in Cloudinary (leave empty for root level)
CLOUDINARY_FOLDER=

# Admin credentials (required for admin panel)
ADMIN_USER=admin
ADMIN_PASS=your_secure_password
