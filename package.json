{
  "name": "deo-gratias-catalog",
  "version": "1.0.0",
  "description": "Deo Gratias luxury jewelry digital catalog with PDF generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npx playwright test tests/catalog.spec.js",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.json",
    "lint:fix": "eslint . --ext .js,.json --fix",
    "scan-secrets": "npx --yes gitleaks detect --source=."
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "puppeteer": "^23.4.0",

    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "express-rate-limit": "^7.2.0",
    "cookie-parser": "^1.4.6",
    "serverless-http": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "semi": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
